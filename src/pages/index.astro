---
import "../styles/app.css";
import "../css/base.css";
import "../css/topbar.css";
export const prerender = true;
---

<html lang="zh-CN" class="dark" data-theme="dark" style="color-scheme: dark;">
  <head>
    <meta charset="utf-8" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/StreamlinePlumpColorWebFlat.svg"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>博客宇宙</title>
    <meta name="description" content="探索浩瀚的博客宇宙，寻找彼此之间的联系" />
    <link rel="preconnect" href="https://github.com" />
	    <script is:inline define:vars={{ enableServiceWorker: import.meta.env.PROD }}>
	      if ("serviceWorker" in navigator) {
	        window.addEventListener("load", async () => {
	          if (enableServiceWorker) navigator.serviceWorker.register("/sw.js");
            else {
              const registrations = await navigator.serviceWorker.getRegistrations();
              for (const registration of registrations) {
                if (registration.active?.scriptURL === new URL("/sw.js", location.origin).href) await registration.unregister();
              }
              for (const key of await caches.keys()) if (key.startsWith("friendlinks-")) await caches.delete(key);
              if (navigator.serviceWorker.controller?.scriptURL === new URL("/sw.js", location.origin).href) location.reload();
            }
	        });
	      }
	    </script>
	  </head>
  <body>
    <div class="topbar">
      <div class="title" style="font-weight:600; padding-left:6px;">
        <span>博客宇宙</span>
        <a
          class="github-link"
          href="https://github.com/xingwangzhe/FriendLinks"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open GitHub repository"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 16 16"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.19 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
        </a>
      </div>
      <div class="search">
        <input
          id="graph-search"
          type="text"
          placeholder="搜索站点名或域名，选择结果聚焦节点"
          autocomplete="off"
         class="input input-bordered w-full" />
        <button id="graph-search-clear" class="btn btn-sm search-clear" aria-label="清空搜索" title="清空搜索" >✖</button>
        <div id="graph-search-results" class="results" role="listbox"></div>
      </div>
    </div>
    <div id="main"></div>

    <!-- 首屏加载蒙版 -->
    <div id="loading-overlay">
      <div class="loading-box">
        <span class="loading loading-spinner loading-lg" aria-label="正在加载"></span>
        <div class="loading-status">
          <span id="loading-text">正在探索博客宇宙...</span>
          <span id="loading-time" class="loading-time"></span>
        </div>
        <progress max="100" class="progress progress-primary w-full" id="loading-bar" value="0" aria-label="加载进度"></progress>
      </div>
    </div>

    <div class="top-buttons">
      <button id="menu-toggle" class="btn btn-sm top-button menu-toggle" aria-label="菜单" title="菜单" >☰</button>
      <div class="top-buttons-group">
        <button id="fly-toggle"  aria-label="切换飞船模式" class="btn btn-sm">🚀 飞船模式</button>
        <button id="about-toggle"  aria-label="关于项目" class="btn btn-sm">关于</button>
        <button id="stats-toggle"  aria-label="查看统计信息" class="btn btn-sm">📊统计信息</button>
        <button id="opacity-toggle"  aria-label="控制面板" class="btn btn-sm">控制面板</button>
        <button id="path-toggle"  aria-label="路径查找" class="btn btn-sm">🔗 路径查找</button>
        <button id="btn-random"  aria-label="随机博客" class="btn btn-sm">🎲 随机博客</button>
        <button id="fullscreen-toggle"  aria-label="全屏模式" class="btn btn-sm">⛶ 全屏模式</button>
      </div>
    </div>

    <!-- 飞船模式 HUD：只保留底部淡文字，不拦截画面指针 -->
    <div id="fly-hud" class="fly-hud" hidden role="status" aria-live="polite">
      <span>鼠标转向</span>
      <span><kbd>WASD</kbd> 平移</span>
      <span><kbd>R</kbd>/<kbd>F</kbd> 升降</span>
      <span><kbd>Q</kbd>/<kbd>E</kbd> 横滚</span>
      <span><kbd>Shift</kbd> 加速</span>
      <span><kbd>Space</kbd> 自动前进 <span id="fly-autopilot-status">OFF</span></span>
      <span class="fly-hud-exit"><kbd>X</kbd> 退出飞船模式</span>
      <span id="fly-pointer-status" class="fly-hud-status">点击宇宙画面锁定鼠标；WASD 只负责平移</span>
    </div>

    <!-- 统计弹窗 -->
    <section id="stats-dialog" class="panel-content" hidden>


        <div id="stats-content" class="space-y-4"></div>

    </section>

    <!-- 关于弹窗 -->
    <section id="about-dialog" class="panel-content" hidden>


        <div class="space-y-5 text-sm">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-lg border p-4">
              <h4 class="mb-2 font-semibold">🖱 操作</h4>
              <ul class="space-y-1 text-muted-foreground">
                <li><strong class="text-foreground">左键</strong> 打开网站</li>
                <li><strong class="text-foreground">中键</strong> 在新标签页打开网站</li>
                <li><strong class="text-foreground">右键</strong> 聚焦节点</li>
                <li><strong class="text-foreground">悬停</strong> 显示信息</li>
                <li><strong class="text-foreground">左键拖拽</strong> 旋转</li>
                <li><strong class="text-foreground">右键拖拽</strong> 平移</li>
                <li><strong class="text-foreground">滚轮</strong> 缩放</li>
              </ul>
            </div>
            <div class="rounded-lg border p-4">
              <h4 class="mb-2 font-semibold">🔍 搜索</h4>
              <ul class="space-y-1 text-muted-foreground">
                <li>输入站点名或域名实时搜索</li>
                <li>点击结果项可<strong class="text-foreground">打开网站</strong>或<strong class="text-foreground">聚焦节点</strong></li>
                <li><code class="rounded bg-muted px-1">?local=example.com</code> 按域名匹配</li>
                <li><code class="rounded bg-muted px-1">?local=https://example.com</code> 按完整 URL 匹配</li>
                <li><strong class="text-foreground">🎲 随机博客</strong> 按钮随机跳转</li>
              </ul>
            </div>
            <div class="rounded-lg border p-4">
              <h4 class="mb-2 font-semibold">✨ 聚焦效果</h4>
              <ul class="space-y-1 text-muted-foreground">
                <li>节点 <strong class="text-foreground">放大 1.5x</strong> + 调亮 60%</li>
                <li>亮金色粗管荧光连线</li>
                <li>邻居节点高亮 20%</li>
                <li>自动居中相机</li>
              </ul>
            </div>
            <div class="rounded-lg border p-4">
              <h4 class="mb-2 font-semibold">➕ 添加友链</h4>
              <p class="text-muted-foreground mb-2">在项目中新建 <code class="rounded bg-muted px-1">links/你的站点.yml</code>：</p>
              <pre class="rounded bg-muted p-2 text-xs overflow-x-auto"><code>name: 我的博客
url: https://example.com
links: /friends
friends:
  - name: 友人
    url: https://friend.com</code></pre>
            </div>
          </div>
          <div class="rounded-lg border p-4">
            <h4 class="mb-2 font-semibold">📋 要求</h4>
            <ul class="space-y-1 text-muted-foreground">
              <li>✅ 仅限<strong class="text-foreground">个人博客</strong>，有原创内容</li>
              <li>✅ 使用 <strong class="text-foreground">HTTPS</strong> 并可在国内访问</li>
              <li>✅ 友链页需包含本站信息</li>
            </ul>
          </div>
          <div class="flex gap-3 justify-end">
            <a href="https://github.com/xingwangzhe/FriendLinks" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 text-xs hover:bg-muted transition-colors">GitHub 仓库</a>
          </div>
        </div>

    </section>
    <!-- 路径查找窗口内容 -->
    <div id="path-bar" class="path-bar" hidden>
      <div class="path-bar-row">
        <span class="path-bar-icon">🔗</span>
        <div class="path-search-wrap">
          <input
            id="path-search-from"
            type="text"
            placeholder="起点站点…"
            autocomplete="off"
           class="input input-bordered w-full" />
          <div id="path-results-from" class="path-results" role="listbox"></div>
        </div>
        <span class="path-arrow">→</span>
        <div class="path-search-wrap">
          <input
            id="path-search-to"
            type="text"
            placeholder="终点站点…"
            autocomplete="off"
           class="input input-bordered w-full" />
          <div id="path-results-to" class="path-results" role="listbox"></div>
        </div>
        <span id="path-step-indicator" class="path-step-info" style="display:none;"></span>
        <button id="path-prev-btn" class="btn btn-sm path-nav-btn" disabled title="上一步" >◀</button>
        <button id="path-next-btn" class="btn btn-sm path-nav-btn" disabled title="下一步" >▶</button>
        <button id="path-clear-btn" class="btn btn-sm path-nav-btn path-clear-btn" title="清除路径" style="display:none;" >✕</button>
        <button id="path-bar-close" class="btn btn-sm path-nav-btn" title="关闭" aria-label="关闭路径查找">✕</button>
      </div>
      <div id="path-error" class="path-bar-error" style="display:none;"></div>
    </div>

    <script>
      import "../scripts/index-client.ts";
    </script>
    <script>
            import { showPanel, hidePanel, togglePanel, isPanelOpen } from "../scripts/ui/windows";
      import { createDebouncedSearch, type DebouncedSearch } from "../scripts/ui/debounced-search";
      type SearchResult = { id: string; name: string; url?: string };
      type StatsData = import("../../types/stats").StatsData;
      (async function () {

        const aboutToggle = document.getElementById("about-toggle");
        aboutToggle?.addEventListener("click", () => togglePanel("about-dialog", aboutToggle));

        // ── 统计弹窗：点击触发时加载数据 ──
        const statsContent = document.getElementById("stats-content");

        if (statsContent) {
          const statsTrigger = document.getElementById("stats-toggle");
          if (statsTrigger) {
            let statsLoaded = false;
            let statsPending: Promise<void> | null = null;
            const loadStats = () => {
              if (statsLoaded) return Promise.resolve();
              if (statsPending) return statsPending;
              statsPending = (async () => {
                statsContent.innerHTML = '<span class="loading loading-spinner" aria-label="加载统计"></span><p>加载统计信息…</p>';
                try {
                  const response = await fetch("/stats.json");
                  if (!response.ok) throw new Error("统计加载失败");
                  const data = await response.json();
                  statsContent.innerHTML = renderStatsCards(data);
                  statsContent.querySelectorAll(".rounded-lg.border").forEach(block => {
                    const card = document.createElement("div");
                    card.className = "card bg-base-200 p-4";
                    const body = document.createElement("div");
                    body.append(...block.childNodes);
                    card.append(body);
                    block.replaceWith(card);
                    card.querySelectorAll("span.font-bold").forEach(value => {
                      const badge = document.createElement("span");
                      badge.className = "badge badge-primary"; badge.textContent = value.textContent;
                      value.replaceWith(badge);
                    });
                  });
                  statsLoaded = true;
                } catch {
                  statsContent.innerHTML = '<p role="alert">统计信息加载失败</p><button id="stats-retry" class="btn btn-sm">重试</button>';
                  document.getElementById("stats-retry")?.addEventListener("click", loadStats);
                }
              })().finally(() => { statsPending = null; });
              return statsPending;
            };
            statsTrigger.addEventListener("click", () => {
              togglePanel("stats-dialog", statsTrigger);
              if (isPanelOpen("stats-dialog")) void loadStats();
            });
          }
        }

		function renderStatsCards(data: StatsData) {
          const safe = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;", "'":"&#39;"}[c] ?? c));
		          const sd = data.sixDegrees;
		          const dist = sd?.edgeDistanceDistribution || {};
		          const distEntries = Object.entries(dist).filter(([d]) => Number(d) <= 20).sort(([a],[b])=>Number(a)-Number(b));
		          const maxVal = Math.max(...distEntries.map(([,c])=>Number(c)), 1);
		          const cd = sd?.compSizeDistribution || [];
		          const maxCompCnt = Math.max(...cd.map(b => b.count), 1);

		          const coreCnt = data.coreNodes.count;
		          const friendCnt = data.friendNodes.count;
		          const totalNodes = data.overview.totalNodes;
		          const ccBi = data.connections.coreToCore.bidirectional;
		          const ccUni = data.connections.coreToCore.unidirectional;
		          const cf = data.connections.coreToFriend;
		          const totalLinks = data.connections.total;
		          const mutualRate = ccBi + ccUni > 0 ? Math.round((ccBi / (ccBi + ccUni)) * 100) : 0;

		          const topLinked = data.topLinked || [];
		          const topLinking = data.topLinking || [];

		          return `
		            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">

		              <!-- 📦 博客宇宙规模 -->
		              <div class="rounded-lg border p-4">
		                <h3 class="mb-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">📦 博客宇宙规模</h3>
		                <div class="space-y-2">
		                  <div class="flex justify-between"><span class="text-muted-foreground text-sm">📝 已注册主站</span><span class="font-bold">${coreCnt.toLocaleString()}</span></div>
		                  <div class="flex justify-between"><span class="text-muted-foreground text-sm">🔗 被引友链站</span><span class="font-bold">${friendCnt.toLocaleString()}</span></div>
		                  <div class="border-t pt-2 flex justify-between"><span class="text-sm font-semibold">🌟 博客宇宙总节点</span><span class="font-bold">${totalNodes.toLocaleString()}</span></div>
		                  <div class="flex justify-between"><span class="text-muted-foreground text-sm">🔗 友链关系总数</span><span class="font-bold">${totalLinks.toLocaleString()} 条</span></div>
		                </div>
		              </div>

		              <!-- 🤝 友链关系 -->
		              <div class="rounded-lg border p-4">
		                <h3 class="mb-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">🤝 友链关系 <span class="text-xs opacity-60">(主站间)</span></h3>
		                <div class="space-y-2">
		                  <div class="flex justify-between"><span class="text-muted-foreground text-sm">🔄 双向互链 <span class="text-xs opacity-60">(互相添加)</span></span><span class="font-bold">${ccBi.toLocaleString()} 对</span></div>
		                  <div class="flex justify-between"><span class="text-muted-foreground text-sm">➡️ 单向关注 <span class="text-xs opacity-60">(仅一方添加)</span></span><span class="font-bold">${ccUni.toLocaleString()} 对</span></div>
		                  <div class="border-t pt-2 flex justify-between"><span class="text-muted-foreground text-sm">💞 互链率</span><span class="font-bold" style="color:${mutualRate > 50 ? '#4ade80' : '#fbbf24'}">${mutualRate}%</span></div>
		                  <div class="flex justify-between"><span class="text-muted-foreground text-sm">🌉 主站→友链</span><span class="font-bold">${cf.toLocaleString()} 条</span></div>
		                </div>
		              </div>

		              <!-- 🏆 人气榜单：最多被链 -->
		              <div class="rounded-lg border p-4">
		                <h3 class="mb-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">🏆 最受欢迎站点 <span class="text-xs opacity-60">(被友链指向最多)</span></h3>
		                <div class="space-y-1">
		                  ${topLinked.slice(0, 6).map((n, i) => `
		                    <div class="flex items-center gap-2 text-sm">
		                      <span class="w-5 text-right shrink-0 ${i < 3 ? 'font-bold' : ''}" style="color:${['#ffd700','#c0c0c0','#cd7f32','#888','#888','#888'][i]}">${['🥇','🥈','🥉','④','⑤','⑥'][i]||'•'}</span>
		                      <span class="text-muted-foreground truncate flex-1">${safe(n.name)}</span>
		                      <span class="font-bold text-xs">${n.inDegree}</span>
		                    </div>
		                  `).join('')}
		                  ${topLinked.length === 0 ? '<div class="text-muted-foreground text-xs">暂无数据</div>' : ''}
		                </div>
		              </div>

		              <!-- 🔗 最活跃博主：最多出链 -->
		              <div class="rounded-lg border p-4">
		                <h3 class="mb-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">🔗 最活跃站点 <span class="text-xs opacity-60">(主动添加友链最多)</span></h3>
		                <div class="space-y-1">
		                  ${topLinking.slice(0, 6).map((n, i) => `
		                    <div class="flex items-center gap-2 text-sm">
		                      <span class="w-5 text-right shrink-0 ${i < 3 ? 'font-bold' : ''}" style="color:${['#ffd700','#c0c0c0','#cd7f32','#888','#888','#888'][i]}">${['🥇','🥈','🥉','④','⑤','⑥'][i]||'•'}</span>
		                      <span class="text-muted-foreground truncate flex-1">${safe(n.name)}</span>
		                      <span class="font-bold text-xs">${n.outDegree}</span>
		                    </div>
		                  `).join('')}
		                  ${topLinking.length === 0 ? '<div class="text-muted-foreground text-xs">暂无数据</div>' : ''}
		                </div>
		              </div>

		              <!-- 🌐 六度分隔 -->
		              <div class="rounded-lg border p-4 sm:col-span-2 lg:col-span-2">
		                <h3 class="mb-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">🌐 六度分隔 · 博客小世界</h3>
		                <div class="grid gap-3 sm:grid-cols-3 mb-4">
		                  <div class="text-center p-2 rounded-lg" style="background:rgba(74,158,255,0.08)">
		                    <div class="text-2xl font-bold" style="color:#4a9eff">${sd?.maxEdgeDistance || '—'}</div>
		                    <div class="text-xs text-muted-foreground mt-1">最多经过几步<br>认识任意博主</div>
		                  </div>
		                  <div class="text-center p-2 rounded-lg" style="background:rgba(74,158,255,0.08)">
		                    <div class="text-2xl font-bold" style="color:#4a9eff">${sd?.avgPathLength ?? '—'}</div>
		                    <div class="text-xs text-muted-foreground mt-1">平均每两个博主<br>隔几步认识</div>
		                  </div>
		                  <div class="text-center p-2 rounded-lg" style="background:rgba(74,158,255,0.08)">
		                    <div class="text-2xl font-bold" style="color:#4a9eff">${sd?.mainComponentSize?.toLocaleString() || '—'}</div>
		                    <div class="text-xs text-muted-foreground mt-1">最大博客圈<br>相互连通的站点数</div>
		                  </div>
		                </div>
		                <div class="space-y-1">
		                  <div class="flex justify-between text-xs text-muted-foreground"><span>距离分布（几步能认识彼此）</span><span>站点对数</span></div>
		                  ${distEntries.map(([d,c]) => {
		                    const w = Math.max(1, Number(c)/maxVal*100).toFixed(0);
		                    return `<div class="flex items-center gap-2 text-xs">
		                      <span class="w-8 text-right text-muted-foreground shrink-0">${d} 步</span>
		                      <span class="h-3 rounded-sm" style="width:${w}%;background:linear-gradient(90deg,#4a9eff,#00c6ff);min-width:2px"></span>
		                      <span class="text-muted-foreground shrink-0">${Number(c).toLocaleString()}</span>
		                    </div>`;
		                  }).join('')}
		                </div>
		              </div>

		              <!-- 🧩 博客圈分布 -->
		              ${cd.length ? `<div class="rounded-lg border p-4 sm:col-span-2 lg:col-span-2">
		                <h3 class="mb-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">🧩 博客圈分布 · ${sd?.componentCount} 个独立小圈子</h3>
		                <div class="mb-3 text-xs text-muted-foreground">
		                  最大的圈子有 <strong class="text-foreground">${sd?.mainComponentSize?.toLocaleString() || '—'}</strong> 个站点相互连通，
		                  另有 <strong class="text-foreground">${sd?.isolatedCount ?? '—'}</strong> 个孤立的博客未与任何主站互联。
		                </div>
		                <div class="space-y-1">
		                  ${cd.map(b => {
		                    const w = Math.max(1, b.count/maxCompCnt*100).toFixed(0);
		                    return `<div class="flex items-center gap-2 text-xs">
		                      <span class="w-16 text-right text-muted-foreground shrink-0">${b.label}</span>
		                      <span class="h-3 rounded-sm" style="width:${w}%;background:linear-gradient(90deg,#4a9eff,#00c6ff);min-width:2px"></span>
		                      <span class="text-muted-foreground shrink-0">${b.count.toLocaleString()} 个</span>
		                    </div>`;
		                  }).join('')}
		                </div>
		              </div>` : ''}

		              <!-- 📊 友链页面路由排行 -->
		              <div class="rounded-lg border p-4 sm:col-span-2 lg:col-span-2">
		                <h3 class="mb-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider">📊 友链页面路由排行 <span class="text-xs opacity-60">(大家都在哪里放友链)</span></h3>
		                <div class="space-y-1">
		                  ${(data.linkRoutes || []).slice(0, 12).map(r => {
		                    const maxRoute = Math.max(...(data.linkRoutes || []).map(x => x.count), 1);
		                    const bw = Math.max(1, (r.count / maxRoute) * 100).toFixed(0);
		                    return `<div class="flex items-center gap-2 text-xs">
		                      <span class="font-mono text-muted-foreground truncate flex-1">${safe(r.route)}</span>
		                      <span class="h-3 rounded-sm" style="width:${bw}%;background:linear-gradient(90deg,#a78bfa,#7c3aed);min-width:2px"></span>
		                      <span class="font-bold shrink-0">${r.count}</span>
		                    </div>`;
		                  }).join('')}
		                </div>
		              </div>

		            </div>
		          `;
		        }

        // 控制面板按钮
        const opacityBtn = document.getElementById("opacity-toggle");
        if (opacityBtn) {
          opacityBtn.addEventListener("click", () => {
            const toggle = window.__toggleOpacityPanel;
            if (typeof toggle === "function") {
              toggle();
            }
          });
	        }

	        // 飞船模式切换
	        const flyBtn = document.getElementById("fly-toggle");
	        if (flyBtn) {
	          flyBtn.addEventListener("click", () => {
	            const api = window.__graphApi;
	            if (api && api.toggleFlightMode) {
	              const isFly = api.toggleFlightMode();
	              flyBtn.textContent = isFly ? "🌐 球幕模式" : "🚀 飞船模式";
	            }
	          });
	        }

	        // 全屏模式切换
	        const fsBtn = document.getElementById("fullscreen-toggle");
	        if (fsBtn) {
	          let fsEscTimes = 0;
            let fsEscTimer: ReturnType<typeof setTimeout> | null = null;
	          fsBtn.addEventListener("click", () => {
	            if (!document.fullscreenElement) {
	              document.documentElement.requestFullscreen().catch(() => {});
	              fsBtn.textContent = "⛶ 退出全屏";
	            } else {
	              document.exitFullscreen().catch(() => {});
	              fsBtn.textContent = "⛶ 全屏模式";
	            }
	          });
	          document.addEventListener("fullscreenchange", () => {
	            fsBtn.textContent = document.fullscreenElement ? "⛶ 退出全屏" : "⛶ 全屏模式";
	          });
	          // ESC 退出全屏（飞船模式下不拦截，飞船模式 X 键退出）
	          document.addEventListener("keydown", (e) => {
	            if (e.key === "Escape" && document.fullscreenElement && !document.pointerLockElement) {
	              const now = Date.now();
	              if (now - fsEscTimes < 600) {
	                document.exitFullscreen().catch(() => {});
	                fsEscTimes = 0;
	                if (fsEscTimer) { clearTimeout(fsEscTimer); fsEscTimer = null; }
	              } else {
	                fsEscTimes = now;
	                fsEscTimer = setTimeout(() => { fsEscTimes = 0; fsEscTimer = null; }, 600);
	              }
	            }
	          });
	        }

	        // ── 路径查找底部栏 ──────────────────────────────────────────
        const pathBar = document.getElementById("path-bar");
        const pathToggleBtn = document.getElementById("path-toggle");
        const pathFromInput = document.querySelector<HTMLInputElement>("#path-search-from");
        const pathToInput = document.querySelector<HTMLInputElement>("#path-search-to");
        const pathFromResults = document.getElementById("path-results-from");
        const pathToResults = document.getElementById("path-results-to");
        const pathStepIndicator = document.getElementById("path-step-indicator");
        const pathPrevBtn = document.querySelector<HTMLButtonElement>("#path-prev-btn");
        const pathNextBtn = document.querySelector<HTMLButtonElement>("#path-next-btn");
        const pathClearBtn = document.getElementById("path-clear-btn");
        const pathBarClose = document.getElementById("path-bar-close");
        const pathError = document.getElementById("path-error");

        const pathSearches = new Map<HTMLInputElement, DebouncedSearch>();
        let selectedFrom: SearchResult | null = null; // { id, name, url }
        let selectedTo: SearchResult | null = null;

        const getApi = () => window.__graphApi || {};

        const showPathBar = () => {
          if (pathBar) {
            showPanel("path-bar", pathToggleBtn ?? undefined);
            if (pathFromInput) pathFromInput.focus();
          }
        };
        const hidePathBar = () => {
          // 仅隐藏底部栏，不清除路径高亮
          pathSearches.forEach(search => search.cancel());
          hidePanel("path-bar");
        };
        const clearPathSelections = () => {
          pathSearches.forEach(search => search.clear());
          selectedFrom = null;
          selectedTo = null;
          if (pathFromInput) { pathFromInput.value = ""; }
          if (pathToInput) { pathToInput.value = ""; }
          if (pathFromResults) { pathFromResults.style.display = "none"; pathFromResults.innerHTML = ""; }
	          if (pathToResults) { pathToResults.style.display = "none"; pathToResults.innerHTML = ""; }
	          if (pathStepIndicator) { pathStepIndicator.style.display = "none"; }
	          if (pathClearBtn) { pathClearBtn.style.display = "none"; }
	          if (pathError) { pathError.style.display = "none"; }
          const api = getApi();
          if (api.clearPath) api.clearPath();
        };

        // 切换按钮
        if (pathToggleBtn) {
          pathToggleBtn.addEventListener("click", () => {
            if (pathBar && isPanelOpen("path-bar")) {
              hidePathBar();
            } else {
              showPathBar();
            }
          });
        }
        // 关闭按钮 — 仅隐藏，不清除
        if (pathBarClose) {
          pathBarClose.addEventListener("click", hidePathBar);
        }

        // 搜索结果渲染
        const renderPathResults = (container: HTMLElement, list: SearchResult[], onSelect: (item: SearchResult) => void) => {
          container.innerHTML = "";
          if (!list || !list.length) {
            container.style.display = "none";
            return;
          }
          for (let i = 0; i < Math.min(list.length, 8); i++) {
            const it = list[i];
            const el = document.createElement("button"); el.className = "btn btn-sm";
            el.classList.add("btn", "btn-ghost", "w-full");
            el.className = "path-result-item";
            const name = document.createElement("div");
            name.className = "path-result-name";
            name.textContent = it.name;
            const url = document.createElement("div");
            url.className = "path-result-url";
            url.textContent = it.url || "";
            el.append(name, url);
            el.addEventListener("click", () => {
              onSelect(it);
              container.style.display = "none";
            });
            container.appendChild(el);
          }
          container.style.display = "block";
        };

        // Path input shares the same debounce and stale-result protection as the main search.
        if (pathFromInput && pathFromResults) {
          const search = createDebouncedSearch<SearchResult>(async (query, signal) => {
            const api = getApi();
            return api.find ? await api.find(query, signal) : [];
          }, (list) => renderPathResults(pathFromResults, list, (item) => {
            search.cancel();
            selectedFrom = item;
            pathFromInput.value = item.name;
            checkBothSelected();
          }));
          pathSearches.set(pathFromInput, search);
          pathFromInput.addEventListener("input", () => {
            selectedFrom = null;
            search.update(pathFromInput.value);
          });
        }
        if (pathToInput && pathToResults) {
          const search = createDebouncedSearch<SearchResult>(async (query, signal) => {
            const api = getApi();
            return api.find ? await api.find(query, signal) : [];
          }, (list) => renderPathResults(pathToResults, list, (item) => {
            search.cancel();
            selectedTo = item;
            pathToInput.value = item.name;
            checkBothSelected();
          }));
          pathSearches.set(pathToInput, search);
          pathToInput.addEventListener("input", () => {
            selectedTo = null;
            search.update(pathToInput.value);
          });
        }

        // 两个站点都选定后自动计算路径
        const checkBothSelected = () => {
          if (!selectedFrom || !selectedTo || !pathError || !pathStepIndicator || !pathClearBtn) return;
          const api = getApi();
          if (!api.showShortestPath) return;

          // 边界条件：起点终点相同
          if (selectedFrom.id === selectedTo.id) {
            pathError.textContent = "起点和终点相同，请选择两个不同的节点";
            pathError.style.display = "block";
            pathStepIndicator.style.display = "none";
            pathClearBtn.style.display = "none";
            return;
          }

          const path = api.showShortestPath(selectedFrom.id, selectedTo.id);
          if (!path || !path.length) {
            pathError.textContent = `未找到从 ${selectedFrom.name} 到 ${selectedTo.name} 的路径`;
            pathError.style.display = "block";
            pathStepIndicator.style.display = "none";
            pathClearBtn.style.display = "none";
            return;
          }

          pathError.style.display = "none";
          pathStepIndicator.style.display = "inline";
          pathClearBtn.style.display = "inline-flex";
          updatePathUI();
        };

        const updatePathUI = () => {
          const api = getApi();
          const info = api.getPathInfo ? api.getPathInfo() : null;
          if (!info || !pathStepIndicator || !pathPrevBtn || !pathNextBtn) return;

          pathStepIndicator.textContent = `${info.currentStep + 1}/${info.totalSteps} 步`;
          pathPrevBtn.disabled = info.currentStep <= 0;
          pathNextBtn.disabled = info.currentStep >= info.totalSteps - 1;
        };

        // 步进按钮
        if (pathPrevBtn) {
          pathPrevBtn.addEventListener("click", () => {
            const api = getApi();
            if (api.stepPathPrev) {
              api.stepPathPrev();
              updatePathUI();
            }
          });
        }
        if (pathNextBtn) {
          pathNextBtn.addEventListener("click", () => {
            const api = getApi();
            if (api.stepPathNext) {
              api.stepPathNext();
              updatePathUI();
            }
          });
        }

        // 清除路径按钮
        if (pathClearBtn) {
          pathClearBtn.addEventListener("click", () => {
            clearPathSelections();
          });
        }

        // 点击外部关闭搜索结果
        document.addEventListener("click", (e) => {
          if (!(e.target instanceof Node)) return;
          if (pathFromInput && pathFromResults && !pathFromInput.contains(e.target) && !pathFromResults.contains(e.target)) {
            pathSearches.get(pathFromInput)?.cancel();
            pathFromResults.style.display = "none";
          }
          if (pathToInput && pathToResults && !pathToInput.contains(e.target) && !pathToResults.contains(e.target)) {
            pathSearches.get(pathToInput)?.cancel();
            pathToResults.style.display = "none";
          }
        });

        // ESC 关闭底部栏（不清除路径）
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && pathBar && isPanelOpen("path-bar")) {
            hidePathBar();
          }
        });
      })();
    </script>
  </body>
</html>
